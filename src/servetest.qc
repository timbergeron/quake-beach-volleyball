void(entity player) BV_RunServeTests =
{
    local vector centre, clean, firm, landing, launch, spin, step;
    local float grade, range, i, phase, age, saved_frame;
    BV_ResetBallRotation();
    BV_AdvanceBallRotation('0 20 0', 0.05);
    BV_Assert("visible-topspin-rotates-forward", bv_visual_forward_z < -0.8 &&
        fabs(bv_visual_forward_y) < 0.001 && bv_draw_angles_x > 270 && bv_draw_angles_y == 0);
    BV_AdvanceBallRotation('0 20 0', 0.05);
    BV_Assert("topspin-draw-crosses-vertical-smoothly", bv_draw_angles_x > 180 &&
        bv_draw_angles_x < 270 && bv_draw_angles_y == 0 && bv_draw_angles_z == 0);
    BV_ResetBallRotation();
    BV_AdvanceBallRotation('0 0 20', 0.05);
    BV_Assert("visible-sidespin-rotates-about-vertical", bv_visual_forward_y > 0.8 &&
        fabs(bv_visual_forward_z) < 0.001 && fabs(bv_visual_up_z - 1) < 0.001);
    i = 0;
    while (i < 100) { BV_AdvanceBallRotation('7 -30 13', BV_STEP); i = i + 1; }
    BV_Assert("mixed-spin-keeps-orthonormal-model", fabs(vlen(bv_visual_forward) - 1) < 0.001 &&
        fabs(vlen(bv_visual_up) - 1) < 0.001 && fabs(bv_visual_forward * bv_visual_up) < 0.001);
    step = bv_draw_angles;
    step_x = -step_x;
    makevectors(step);
    BV_Assert("draw-angles-match-physical-spin-basis", vlen(v_forward - bv_visual_forward) < 0.001 &&
        vlen(v_up - bv_visual_up) < 0.001);
    BV_StopMatch();
    BV_TestContactSetup(player, 1);
    player.bv_assisted = FALSE;
    player.bv_mode = 1;
    bv_feeder = player;
    bv_last_player = world;
    bv_ball.velocity = '-300 0 -200';
    player.bv_read_direction = normalize(bv_ball.velocity);
    BV_ContactZone(player, '-271 0 44');
    centre = bv_hand_position;
    setorigin(bv_ball, centre);
    BV_Assert("receive-uses-forearm-height", centre_z == 44 && BV_IsReceiving(player));
    BV_ResolveContact(player, centre);
    clean = bv_contact_velocity;
    grade = bv_contact_quality;
    BV_Assert("centred-timed-receive-is-clean", grade > 0.99 && clean_x > 0 && clean_z > 0);
    player.bv_charge = 0;
    BV_ResolveContact(player, centre);
    BV_Assert("receive-does-not-charge-power", vlen(clean - bv_contact_velocity) < 0.001);
    bv_ball.velocity = '-600 0 -400';
    BV_ResolveContact(player, centre);
    BV_Assert("receive-rebounds-incoming-energy", vlen(bv_contact_velocity) > vlen(clean) + 100);
    bv_ball.velocity = '-300 0 -200';
    player.bv_depth = 1;
    BV_ResolveContact(player, centre);
    firm = bv_contact_velocity;
    player.bv_depth = -1;
    BV_ResolveContact(player, centre);
    BV_Assert("cushion-absorbs-hard-serves", vlen(firm) > vlen(bv_contact_velocity) + 100);
    player.bv_depth = 0;
    player.bv_arc = 0.8;
    BV_ResolveContact(player, centre);
    BV_Assert("platform-arc-steers-rebound", bv_contact_velocity_z > clean_z && bv_contact_velocity_x < clean_x);
    player.bv_arc = 0.35;
    player.bv_aim = '0 1 0';
    BV_ResolveContact(player, centre);
    BV_Assert("platform-aim-steers-rebound", bv_contact_velocity_y > 100 && fabs(bv_contact_velocity_x) < 1);
    player.bv_aim = '1 0 0';
    setorigin(bv_ball, centre - bv_ball.velocity * 0.12);
    player.bv_preparing = 1;
    BV_Release(player);
    BV_ResolveContact(player, centre);
    BV_Assert("early-release-loses-receive-control", bv_contact_quality < grade - 0.3 && bv_contact_reason == BV_NOTE_EARLY);
    player.bv_receive_committed = FALSE;
    player.bv_preparing = 1;
    setorigin(bv_ball, centre + bv_ball.velocity * 0.12);
    BV_Release(player);
    BV_ResolveContact(player, centre);
    BV_Assert("late-release-loses-receive-control", bv_contact_quality < grade - 0.3 && bv_contact_reason == BV_NOTE_LATE);
    player.bv_receive_committed = FALSE;
    player.bv_preparing = 1;
    setorigin(bv_ball, centre);
    BV_Release(player);
    BV_ResolveContact(player, centre);
    BV_Assert("manual-release-keeps-clean-window", bv_contact_quality > 0.99 && player.bv_release_timing > 0.99);
    player.bv_receive_committed = FALSE;
    player.bv_preparing = 1;
    player.bv_assisted = TRUE;
    BV_ResolveContact(player, centre);
    BV_Assert("training-assist-cannot-perfect-receive", bv_contact_quality < 0.9 && BV_ReceiveTiming(player) <= 0.6);
    player.bv_assisted = FALSE;
    player.bv_preparing = 0;
    BV_ResolveContact(player, centre + '0 25 0');
    BV_Assert("stretched-receive-shanks", bv_contact_quality < 0.75 && bv_contact_reason == BV_NOTE_REACH && bv_contact_velocity_y > clean_y + 10);
    player.bv_read_direction = normalize('300 0 200');
    BV_ResolveContact(player, centre);
    BV_Assert("wrong-platform-cannot-auto-correct", bv_contact_reason == BV_NOTE_PLATFORM && bv_contact_velocity_x < 0);
    player.bv_action = 2;
    BV_ContactZone(player, bv_ball.origin);
    centre = bv_hand_position;
    setorigin(bv_ball, centre - bv_ball.velocity * 0.12);
    player.bv_read_direction = normalize(bv_ball.velocity);
    player.bv_preparing = 2;
    BV_Release(player);
    BV_ResolveContact(player, centre);
    BV_Assert("overhead-receive-also-requires-timing", bv_shot_kind == BV_SET && bv_contact_quality < 0.7);

    BV_TestReset(player);
    player.bv_serve_style = BV_FLOAT_SERVE;
    BV_BeginPreparation(player, 1);
    player.bv_charge = 1;
    player.bv_arc = 0.35;
    player.bv_sidespin = 0;
    player.bv_last_pitch = 0;
    BV_BuildShot(player, '-271 0 98');
    launch = bv_shot_velocity;
    BV_Assert("float-serve-fast-without-topspin", vlen(launch) > 490 && vlen(bv_shot_spin) < 0.01 && bv_shot_float == 1);
    BV_PredictFlight('-271 0 98', launch, bv_shot_spin, bv_shot_float, 0.4);
    landing = bv_landing;
    BV_Assert("float-serve-clears-net-and-lands-in", !bv_predict_net && !bv_predict_under_net && BV_InCourt(landing) && landing_x > 0);
    BV_PredictFlight('-271 0 98', launch, '0 0 0', 1, 0.4);
    BV_Assert("float-preview-is-repeatable", vlen(bv_landing - landing) < 0.001);
    BV_PredictFlight('-271 0 98', launch, '0 0 0', 1, 2.1);
    BV_Assert("float-seeds-vary-flight", vlen(bv_landing - landing) > 1);
    BV_IntegrateFlight('-271 0 98', launch, '0 20 0', BV_STEP, 1, 0.4);
    step = bv_step_velocity;
    BV_Integrate('-271 0 98', launch, '0 20 0', BV_STEP);
    BV_Assert("spin-suppresses-float-wake", vlen(step - bv_step_velocity) < 0.001);
    player.bv_preparing = 0;
    player.bv_armed_until = 0;
    player.bv_serve_contact = FALSE;
    bv_holder = world;
    bv_last_player = world;
    bv_feeder = world;
    bv_ball_state = BV_LIVE;
    setorigin(bv_ball, '-271 0 98');
    bv_ball.velocity = launch;
    bv_ball_spin = '0 0 0';
    bv_ball_float = 1;
    bv_ball_phase = 0.4;
    bv_live_time = 0;
    i = 0;
    while (bv_ball_state == BV_LIVE && i < 1000)
    {
        BV_BallStep(BV_STEP);
        i = i + 1;
    }
    BV_Assert("float-preview-matches-live", vlen(bv_ball.origin - landing) < 0.1);
    BV_Assert("float-state-clears-on-landing", bv_ball_float == 0);
    saved_frame = frametime;
    setorigin(bv_ball, '-600 220 200');
    bv_ball.velocity = '200 0 100';
    bv_ball_spin = '0 0 0';
    bv_ball_float = 1;
    bv_ball_phase = 0.4;
    bv_ball_state = BV_LIVE;
    bv_live_time = 0;
    bv_accumulator = 0;
    frametime = 0.01;
    i = 0;
    while (i < 100) { BV_UpdateBall(); i = i + 1; }
    step = bv_ball.origin;
    age = bv_live_time;
    setorigin(bv_ball, '-600 220 200');
    bv_ball.velocity = '200 0 100';
    bv_ball_spin = '0 0 0';
    bv_ball_float = 1;
    bv_ball_phase = 0.4;
    bv_ball_state = BV_LIVE;
    bv_live_time = 0;
    bv_accumulator = 0;
    frametime = 0.05;
    i = 0;
    while (i < 20) { BV_UpdateBall(); i = i + 1; }
    BV_Assert("float-flight-independent-of-server-frames", vlen(bv_ball.origin - step) < 0.01 &&
        fabs(bv_live_time - age) < 0.001);
    frametime = saved_frame;

    BV_TestReset(player);
    player.bv_serve_style = BV_TOPSPIN_SERVE;
    BV_BeginPreparation(player, 1);
    BV_Assert("topspin-serve-has-higher-toss", bv_ball.velocity_z == 210);
    player.flags = player.flags - (player.flags & FL_ONGROUND);
    player.bv_charge = 1;
    player.bv_arc = 0.35;
    BV_BuildShot(player, '-271 0 137');
    launch = bv_shot_velocity;
    spin = bv_shot_spin;
    BV_Assert("jump-serve-fast-forward-spin", vlen(launch) > 670 && spin_y > 100 && bv_shot_float == 0);
    BV_Predict('-271 0 137', launch, spin);
    range = bv_landing_x;
    BV_Assert("jump-topspin-clears-net-and-lands-in", !bv_predict_net && !bv_predict_under_net && BV_InCourt(bv_landing) && range > 0);
    BV_Predict('-271 0 137', launch, '0 0 0');
    BV_Assert("forward-spin-drops-serve-earlier", bv_landing_x > range + 50);
    player.flags = player.flags | FL_ONGROUND;
    BV_BuildShot(player, '-271 0 98');
    BV_Assert("standing-topspin-loses-jump-pace", vlen(bv_shot_velocity) < vlen(launch) * 0.8);
    player.bv_serve_contact = FALSE;
    player.bv_mode = 1;
    BV_Feed(player, FALSE);
    BV_Assert("topspin-receive-drill-spins-forward", bv_ball_spin_y < -100 && bv_ball_float == 0);
    player.bv_serve_style = BV_FLOAT_SERVE;
    BV_Feed(player, FALSE);
    BV_Assert("float-receive-drill-has-wake", bv_ball_float == 1 && vlen(bv_ball_spin) == 0);
    phase = bv_ball_phase;
    BV_Forecast(44);
    BV_Assert("bot-forecast-does-not-mutate-float", bv_ball_phase == phase && bv_ball_float == 1);
    BV_StartMatch(player);
    BV_Assert("doubles-starts-with-manual-human-contact", !player.bv_assisted);
    bv_away_score = 1;
    BV_MatchServe();
    BV_Assert("opponent-mixes-in-topspin-serves", bv_server.bv_serve_style == BV_TOPSPIN_SERVE);
    bv_match_phase = BV_MATCH_RALLY;
    bv_touch_team = 1;
    bv_touches = 3;
    player.bv_serve_contact = FALSE;
    player.bv_action = 1;
    player.bv_receive_committed = TRUE;
    player.bv_release_timing = 0;
    player.bv_release_error = 0.15;
    player.bv_prepare_started = time - 0.5;
    player.bv_aim = '1 0 0';
    bv_ball.velocity = '-300 0 -200';
    player.bv_read_direction = normalize(bv_ball.velocity);
    BV_ContactZone(player, player.origin + '17 0 20');
    centre = bv_hand_position;
    setorigin(bv_ball, centre);
    bv_ball_state = BV_LIVE;
    bv_ball_float = 1;
    BV_Contact(player, centre);
    BV_Assert("match-first-touch-keeps-receive-grade", bv_touch_team < 0 && bv_touches == 1 &&
        player.bv_quality < 0.7 && player.bv_contact_note == BV_NOTE_EARLY);
    BV_Assert("receive-contact-consumes-float-flight", bv_ball_float == 0 &&
        !player.bv_receive_contact && !player.bv_receive_committed);
    BV_StopMatch();
    player.bv_serve_style = BV_FLOAT_SERVE;
    BV_TestReset(player);
    player.impulse = 45;
    PlayerPreThink();
    BV_Assert("serve-type-switch-uses-normal-input", player.bv_serve_style == BV_TOPSPIN_SERVE);
    BV_BeginPreparation(player, 1);
    player.impulse = 45;
    PlayerPreThink();
    BV_Assert("serve-type-cannot-change-during-toss", player.bv_serve_style == BV_TOPSPIN_SERVE && player.bv_serve_contact);
    player.bv_serve_style = BV_FLOAT_SERVE;
    BV_TestReset(player);
    player.bv_preparing = 0;
    player.bv_armed_until = 0;
    bv_holder = world;
    bv_ball_state = BV_LIVE;
    setorigin(bv_ball, '-600 220 200');
    bv_ball.velocity = '200 0 100';
    bv_ball_spin = '0 20 0';
    BV_BallStep(BV_STEP);
    BV_Assert("live-model-shows-forward-spin", bv_ball.angles_x > 270 &&
        bv_ball.angles_y == 0 && bv_ball.angles_z == 0);
    BV_TestReset(player);
};
